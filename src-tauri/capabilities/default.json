{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for 幻画 AI",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "os:allow-arch",
    "os:allow-platform",
    "opener:default",
    "process:allow-restart",
    "store:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-write-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
