{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for 幻画 AI",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-toggle-devtools",
    "allow-cutout-inference",
    "dialog:default",
    "os:allow-arch",
    "os:allow-platform",
    "opener:default",
    "process:allow-restart",
    "store:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "fs:default",
    "fs:allow-create",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-stat",
    "fs:allow-seek",
    "fs:allow-remove",
    "fs:allow-write",
    "fs:allow-mkdir",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/models" },
        { "path": "$APPDATA/models/*" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
